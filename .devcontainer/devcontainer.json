{
  "name": "PiliPlus Android",
  "initializeCommand": "python3 docker/run.py --build-only",
  "image": "piliplus-android-builder:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/piliplus,type=bind",
  "workspaceFolder": "/workspaces/piliplus",
  "containerEnv": {
    "SRC": "/workspaces/piliplus",
    "WORK": "/work",
    "OUT": "/workspaces/piliplus/build/docker-out"
  },
  "mounts": [
    "source=${localWorkspaceFolder}/build/docker-cache/work,target=/work,type=bind",
    "source=${localWorkspaceFolder}/build/docker-cache/gradle,target=/home/ubuntu/.gradle,type=bind",
    "source=${localWorkspaceFolder}/build/docker-cache/pub,target=/home/ubuntu/.pub-cache,type=bind",
    "source=${localWorkspaceFolder}/build/docker-cache/android-home,target=/home/ubuntu/.android,type=bind"
  ],
  "remoteUser": "ubuntu",
  "overrideCommand": true,
  "runArgs": [
    "--init"
  ]
}
